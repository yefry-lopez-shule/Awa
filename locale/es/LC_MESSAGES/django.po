msgstr "Elige un Curso en el que estés matriculado este Cuatrimestre."

#: .\studying\views.py:226
msgid "Hours must be a number."
msgstr "Las horas deben ser un número."

#: .\studying\views.py:229
msgid "Hours must be greater than zero."
msgstr "Las horas deben ser mayores que cero."

#: .\studying\views.py:236
msgid "A Study Log needs the date you studied."
msgstr "Un Registro de estudio necesita la fecha en que estudiaste."

#: .\studying\views.py:241
msgid "The date studied must be a valid date."
msgstr "La fecha estudiada debe ser una fecha válida."

#: .\studying\views.py:424 .\studying\views.py:895
msgid "Choose an item type from the Program's list."
msgstr "Elige un tipo de ítem de la lista del Programa."

#: .\studying\views.py:430 .\studying\views.py:900
msgid "A weight must be a number."
msgstr "Un peso debe ser un número."

#: .\studying\views.py:433 .\studying\views.py:903
msgid "A weight must be greater than zero."
msgstr "Un peso debe ser mayor que cero."

#: .\studying\views.py:441 .\studying\views.py:910
msgid "A due date must be a valid date."
msgstr "Una fecha de entrega debe ser una fecha válida."

#: .\studying\views.py:448
msgid "A grade must be a number."
msgstr "Una nota debe ser un número."

#: .\studying\views.py:452
#, python-format
msgid "A grade must be between 0 and %(max)s."
msgstr "Una nota debe estar entre 0 y %(max)s."

#: .\studying\views.py:466
#, python-format
msgid "Weights must sum to %(max)s; the current items sum to %(total)s."
msgstr "Los pesos deben sumar %(max)s; los ítems actuales suman %(total)s."

#: .\studying\views.py:523
msgid "Invalid status submitted."
msgstr "Se envió un estado no válido."

#: .\studying\views.py:532
msgid "Grade must be a number."
msgstr "La nota debe ser un número."

#: .\studying\views.py:535
msgid "A grade may only be recorded for a passed or failed Course."
msgstr "Una nota solo puede registrarse para un Curso aprobado o reprobado."

#: .\studying\views.py:546
msgid "A Slot needs both a código and a name, or neither."
msgstr "Un Slot necesita un código y un nombre, o ninguno de los dos."

#: .\studying\views.py:568
msgid "Marking a Course in progress needs this term's start and end dates."
msgstr "Marcar un Curso en curso necesita las fechas de inicio y fin de este cuatrimestre."

#: .\studying\views.py:577
msgid "Term dates must be valid dates."
msgstr "Las fechas del Cuatrimestre deben ser fechas válidas."

#: .\studying\views.py:671
msgid "Last Term closed."
msgstr "Último Cuatrimestre cerrado."

#: .\studying\views.py:688
msgid "Cuatrimestre set up."
msgstr "Cuatrimestre configurado."

#: .\studying\views.py:745
msgid "Choose passed or failed for every closing Course."
msgstr "Elige aprobado o reprobado para cada Curso que se cierra."

#: .\studying\views.py:748
msgid "A closing Course is either passed or failed."
msgstr "Un Curso que se cierra está aprobado o reprobado."

#: .\studying\views.py:807
msgid "a start date"
msgstr "una fecha de inicio"

#: .\studying\views.py:808
msgid "an end date"
msgstr "una fecha de fin"

#: .\studying\views.py:810
msgid "The Term's start date must come before its end date."
msgstr "La fecha de inicio del Cuatrimestre debe ser anterior a su fecha de fin."

